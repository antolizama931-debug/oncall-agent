# Public metadata only. Do not put browser-visible secrets in frontend/config.js.
ONCALL_ENV=development
ONCALL_RATE_LIMIT_PER_MINUTE=5
ONCALL_DAILY_LIMIT=30
ONCALL_ALLOW_RULE_FALLBACK=true
ONCALL_STATUS_CACHE_SECONDS=300
ONCALL_STATUS_SCENARIO_LIMIT=36
ONCALL_STATUS_PER_SOURCE_LIMIT=12
ONCALL_MAX_RUNS=100
ONCALL_MAX_DOCUMENTS=50
ONCALL_MAX_SESSIONS=100
ONCALL_MEMORY_RECENT_MESSAGES=8
ONCALL_MEMORY_SUMMARY_CHARS=2400
ONCALL_CONTEXT_MAX_CHARS=12000
# 本地默认 ./data；Railway 挂载 Volume 后可设为挂载路径（例如 /data）。
ONCALL_DATA_DIR=./data
ONCALL_DENSE_MIN_SCORE=0.36
# 企业告警入口凭据。生产环境必须设置为高强度随机值，请勿提交到 Git。
ONCALL_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
# 可选：部署在企业私网内的只读遥测工具网关。公开站不配置时明确显示未连接。
ONCALL_TOOL_GATEWAY_URL=
ONCALL_TOOL_GATEWAY_TOKEN=
ONCALL_TOOL_GATEWAY_TIMEOUT_SECONDS=5

# Server-side only. Never put this value in frontend/config.js or GitHub.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2200
